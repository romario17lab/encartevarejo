# Copie para .env e ajuste. Nunca coloque segredos reais no repositório.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/encartevarejo
# Banco usado pelos testes automatizados (será limpo a cada execução)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/encartevarejo_test
# URL pública da aplicação (usada em links, QR codes e e-mails)
APP_URL=http://localhost:3000
# Nome da marca exibido na interface (marca configurável)
NEXT_PUBLIC_BRAND_NAME=EncarteVarejo
# Segredo para assinar sessões e URLs privadas (gere com: openssl rand -hex 32)
APP_SECRET=troque-por-um-valor-aleatorio-longo
# Pasta local para arquivos enviados e exportações (em produção, use armazenamento S3 compatível)
STORAGE_DIR=./storage
# Caminho do Chromium usado nas exportações (Playwright). Deixe vazio para usar o padrão.
CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
# E-mail transacional (opcional). Sem SMTP, os e-mails ficam visíveis em /dev/emails no ambiente de desenvolvimento.
SMTP_URL=
EMAIL_FROM="EncarteVarejo <nao-responda@exemplo.com>"
# Defina 1 quando a aplicação estiver atrás de um proxy/CDN confiável que preenche X-Forwarded-For
# (necessário para o limite de tentativas por IP). Sem proxy confiável, deixe 0.
TRUST_PROXY=1
# URL que o worker usa para abrir as páginas de renderização (normalmente igual a APP_URL)
RENDER_BASE_URL=http://localhost:3000
# 1 = exporta dentro do processo web (desenvolvimento/testes). Em produção use o worker (npm run worker).
EXPORT_INLINE=0
